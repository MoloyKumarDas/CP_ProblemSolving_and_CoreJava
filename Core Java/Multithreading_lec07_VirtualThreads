// virtual thread: exist to provide scale (higher throughput), not speed
// use when a great number of concurrent task that spends much of their time waiting   // api call, query call
// a single jvm might support millions of virtual threads
// they aren't intended for long-running cpu-intensive operations   // typically they have a shallow/less thread stack -> many lightweight tasks  // in that case , use platform threads

// cpu-heavy work: virtual thread don't give a major advantages
// IO-heavy work/waiting work: virtual thread are very useful

package multitThreading;

import java.util.ArrayList;
import java.util.List;

public class VirtualThreading {
    public static void main(String[] args) throws InterruptedException {
//        final int numberOfThreads=10_000;
        final int numberOfThreads=10_000_00_0;           // 10 million  // java uses _ instead of , as a digit separator
        List<Thread>listThreads=new ArrayList<>();

        Runnable objRunnable=new Runnable() {
            @Override
            public void run() {
                // simulate fetching data from url
                System.out.println("fetching dta from api");
                try{
                    Thread.sleep(10000);
                } catch (InterruptedException e) {
                    e.printStackTrace();
                }
                System.out.println("data fetched from api");
            }
        };

        for(int i=0;i<numberOfThreads;i++){
//            Thread thread=new Thread(objRunnable);                                        // platform thread
            Thread thread=Thread.ofVirtual().unstarted(objRunnable);                        // virtual thread
            // cpu capacity and memory
            // (platform threads) typically have a large thread stack and other resources

//            thread.setDaemon(true);              // not needed for virtual thread    // needed for platform thread
            thread.setName("thread "+i);
            thread.start();
            String str=String.format("thread number %s",i);
            System.out.println(str);
            listThreads.add(thread);
        }

        for(Thread thr:listThreads){
            thr.join();
            System.out.println(thr.getName()+" completed");
        }
    }
}
