                Thread.sleep(2000);              // for sleep method, we have to handle try-catch exception
                // main thread still running until this thread completed  // 2s
            } catch (InterruptedException e) {
                throw new RuntimeException(e);
            }
            System.out.println("thread 3 completed");          // thread3 will not complete when used setDemon(true) // below
        };
        Thread thread3 = new Thread(objRunnable, "runnable thread");
        thread3.setDaemon(true);                               // when we don't want main thread to wait for other thread
