package multitThreading;

import java.util.concurrent.ArrayBlockingQueue;
import java.util.concurrent.ThreadPoolExecutor;
import java.util.concurrent.TimeUnit;

public class ThreadPoolExample {
    public static void main(String[] args) {

        // Build a thread pool with fixed boundaries
        ThreadPoolExecutor executor = new ThreadPoolExecutor(
                2,
                4,
                60,TimeUnit.SECONDS,
                new ArrayBlockingQueue<>(5)
//                new ThreadPoolExecutor.AbortPolicy()                 // optional -> default Behaviour
        );

        // Submit 8 tasks to the pool
        for (int i = 1; i <= 8; i++) {
            final int taskId = i;
            executor.execute(() -> {
                System.out.println("Task " + taskId + " running on thread: " + Thread.currentThread().getName());
                try {
                    Thread.sleep(1000); // Simulate execution delay
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                }
            });
        }

        // Always gracefully shut down the executor when tasks are finished
        executor.shutdown();
    }
}
